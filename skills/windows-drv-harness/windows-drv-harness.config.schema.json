{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/Letenz/windows-drv-harness/blob/main/skills/windows-drv-harness/windows-drv-harness.config.schema.json",
  "title": "windows-drv-harness user configuration v2",
  "description": "Machine-local multi-target configuration. The active file belongs under LOCALAPPDATA, not inside the installed skill.",
  "type": "object",
  "required": ["version", "host", "targets"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "default_target": { "type": "string", "minLength": 1 },
    "_comment": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "vmrun_path": { "type": "string" },
        "vmmon64_path": { "type": "string" },
        "windbg_path": { "type": "string" },
        "msbuild_path": { "type": "string" },
        "symbols_path": { "type": "string" },
        "_comment": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z0-9._-]+$": { "$ref": "#/definitions/target" }
      }
    }
  },
  "definitions": {
    "target": {
      "type": "object",
      "required": ["vmx_path", "baseline_snapshot", "kd_pipe", "mcp_pipe", "guest"],
      "additionalProperties": true,
      "properties": {
        "vmx_path": {
          "type": "string",
          "description": "Absolute path explicitly supplied or confirmed by the user.",
          "pattern": "^$|\\.vmx$"
        },
        "baseline_snapshot": {
          "type": "string",
          "description": "Snapshot saved after boot and a verified WinDbg two-machine attach."
        },
        "kd_pipe": {
          "type": "string",
          "description": "VirtualKD main pipe explicitly bound to this VM, for example kd_win10_lab.",
          "pattern": "^$|^[A-Za-z0-9._-]{1,240}$"
        },
        "mcp_pipe": {
          "type": "string",
          "description": "Unique windbg-mcp v2 endpoint for this target.",
          "pattern": "^[A-Za-z0-9._-]{1,240}$"
        },
        "guest": {
          "type": "object",
          "required": ["admin_user", "admin_password", "deploy_dir"],
          "additionalProperties": true,
          "properties": {
            "admin_user": { "type": "string" },
            "admin_password": {
              "type": "string",
              "description": "Local plaintext or ${env:VAR_NAME}. It is never returned by harness tools."
            },
            "deploy_dir": { "type": "string" },
            "arch": { "type": "string", "enum": ["x64", "x86", "arm64"] }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "baseline_debugger_attached": {
              "type": "boolean",
              "description": "True only when the baseline was saved after WinDbg attached successfully."
            }
          }
        },
        "_comment": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    }
  }
}
