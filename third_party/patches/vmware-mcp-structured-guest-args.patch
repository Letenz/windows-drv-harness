+    @staticmethod
+    def _normalize_guest_args(args: str | Sequence[str] | None) -> list[str]:
+        """Return argv tokens for runProgramInGuest extra args.
+
+        MCP callers should prefer a JSON array so Windows service arguments
+        such as ``binPath=`` and paths with spaces stay as separate argv items.
+        Strings are kept for backward compatibility.
+        """
+        if not args:
+            return []
+        if isinstance(args, (list, tuple)):
+            return [str(arg) for arg in args]
+        if not isinstance(args, str):
+            return [str(args)]
+        if os.name == "nt":
+            return _windows_command_line_to_argv(args)
+        return shlex.split(args)
