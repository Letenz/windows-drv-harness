Windows Registry Editor Version 5.00

; VirtualKD-Redux Monitor configuration for driver-harness-mcp
; This sets DebuggerType=2 (Custom) and configures the command template
; to auto-launch WinDbg Preview with the MCP extension loaded.
;
; IMPORTANT: This writes to HKLM (not HKCU).
;            vmmon64.exe is UAC-elevated and reads HKLM only.
;
; Before importing:
;   1. Replace <WINDBG_PREVIEW_PATH> with your DbgX.Shell.exe parent directory
;   2. Replace <EXTENSION_DLL_PATH> with the full path to windbgmcpExt.dll
;
; After importing: restart vmmon64.exe for changes to take effect.

[HKEY_LOCAL_MACHINE\Software\VirtualKD-Redux\Monitor]
"DebuggerType"=dword:00000002
"CustomDebuggerTemplate"="\"<WINDBG_PREVIEW_PATH>\\DbgX.Shell.exe\" -k com:pipe,port=$(pipename),resets=0,reconnect -d -c \".load <EXTENSION_DLL_PATH>\\windbgmcpExt.dll; !mcpstart\""
"AutoInvokeDebugger"=dword:00000001
"InitialBreakIn"=dword:00000001
"WaitForOS"=dword:00000001
